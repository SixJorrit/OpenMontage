    "bingo_testimonials_8kFCyA": {
      "type": "bingo-testimonials",
      "blocks": {
        "item_B7fDUV": {
          "type": "item",
          "settings": {
            "title": "Anouk van Leeuwen (Zaan primair onderwijs)",
            "profession": "i-coach",
            "position": "1",
            "review": "We zijn bij Zaan Primair erg blij met Mediajungle! Vooral de combinatie van het platform en het fysieke materiaal is fantastisch! Vanmorgen heb ik de praatplaten nog gebruikt om met ouders in gesprek te gaan. Het materiaal is op zoveel manieren in te zetten."
          }
        },
        "item_xxNHAC": {
          "type": "item",
          "settings": {
            "title": "Franka van Deursen (Stichting Prodas)",
            "profession": "Projectleider digitale geletterdheid",
            "position": "2",
            "review": "We zijn ontwikkelpartner van het Mediajungle Educatieplatform geworden omdat Mediajungle meebeweegt met de razendsnelle online ontwikkelingen en trends. Daardoor kunnen we makkelijk inspelen op wat er nú speelt. Vooral de duidelijke link met de (concept)kerndoelen van SLO, het accent op media-empowerment en mediawelzijn, en de sterke combinatie van online en offline aanbod spreken ons aan. Ook vinden we het waardevol dat er aanvullend aanbod is om thuis met mediawijsheid aan de slag te gaan."
          }
        },
        "item_HWekNb": {
          "type": "item",
          "settings": {
            "title": "Angeline Zwiers (Ambiq)",
            "profession": "Mediacoach",
            "position": "3",
            "review": "Aantrekkelijk, begrijpelijk, actueel en motiverend zijn voor ons relevante kernwoorden om kinderen, jongeren en ouders  mediawijs te maken. Daarom  hebben wij gekozen voor het platform Mediajungle. Het geeft ons de mogelijkheid om gebruik te maken van verschillende thema's en spelvormen die actueel zijn in de online wereld."
          }
        }
      },
